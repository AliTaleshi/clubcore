# Copy to .env and adjust. Never commit the real .env.

# --- Database ---
POSTGRES_DB=clubcore
POSTGRES_USER=clubcore
POSTGRES_PASSWORD=change-me-db-password

# --- Security ---
# At least 32 characters; generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars

# Public URL users open in the browser (used for payment gateway callbacks)
APP_PUBLIC_URL=http://localhost:3000
HTTP_PORT=3000

# Bootstrap admin (created on first start if no admin exists)
ADMIN_PHONE=09120000000
ADMIN_PASSWORD=Admin@12345

# Load demo plans, members, visits, payments (only on an empty database)
SEED_DEMO=true

# --- Payment gateways (active one is chosen in Settings) ---
# The mock gateway approves payments without charging anyone: enable it ONLY for development/demos.
# When disabled, the active gateway falls back to Zarinpal.
PAYMENT_MOCK_ENABLED=true
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=true
# "zibal" is Zibal's public test merchant
ZIBAL_MERCHANT=zibal

# --- SMS (mock logs messages instead of sending) ---
SMS_PROVIDER=mock
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

# --- AI (leave empty to use built-in local fallbacks) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
